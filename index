<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Andrew Dezelan for Indiana State Senate District 31</title>
    <meta name="description" content="Andrew Dezelan - Democratic candidate for Indiana State Senate District 31">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #1f2937;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 60px 20px;
            text-align: center;
        }
        
        .header {
            margin-bottom: 40px;
        }
        
        h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #1e40af;
            margin-bottom: 10px;
        }
        
        .tagline {
            font-size: 1.5rem;
            color: #4b5563;
            font-weight: 300;
            margin-bottom: 5px;
        }
        
        .district {
            font-size: 1.2rem;
            color: #6b7280;
            margin-top: 10px;
        }
        
        .coming-soon {
            background: #f3f4f6;
            padding: 40px;
            border-radius: 8px;
            margin: 40px 0;
        }
        
        .date {
            font-size: 4rem;
            font-weight: 700;
            color: #1e40af;
            margin-bottom: 20px;
        }
        
        .message {
            font-size: 1.2rem;
            color: #4b5563;
            margin-bottom: 30px;
        }
        
        .email-signup {
            max-width: 500px;
            margin: 0 auto;
        }
        
        form {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        
        input[type="email"] {
            flex: 1;
            padding: 12px 16px;
            font-size: 1rem;
            border: 2px solid #d1d5db;
            border-radius: 4px;
        }
        
        input[type="email"]:focus {
            outline: none;
            border-color: #1e40af;
        }
        
        button {
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: 600;
            background: #1e40af;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        
        button:hover {
            background: #1e3a8a;
        }
        
        .donate-section {
            margin: 50px 0;
            padding: 40px;
            background: #eff6ff;
            border-radius: 8px;
        }
        
        .donate-section h2 {
            font-size: 1.8rem;
            color: #1e40af;
            margin-bottom: 20px;
        }
        
        .donate-button {
            display: inline-block;
            padding: 16px 40px;
            font-size: 1.2rem;
            font-weight: 600;
            background: #1e40af;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            transition: background 0.2s;
        }
        
        .donate-button:hover {
            background: #1e3a8a;
        }
        
        .disclaimer {
            margin-top: 20px;
            font-size: 0.85rem;
            color: #6b7280;
            line-height: 1.5;
        }
        
        .footer {
            margin-top: 60px;
            padding-top: 30px;
            border-top: 1px solid #e5e7eb;
        }
        
        .social-links {
            margin-bottom: 20px;
        }
        
        .social-links a {
            display: inline-block;
            margin: 0 15px;
            color: #1e40af;
            text-decoration: none;
            font-weight: 500;
        }
        
        .social-links a:hover {
            text-decoration: underline;
        }
        
        .paid-for {
            font-size: 0.9rem;
            color: #6b7280;
        }
        
        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }
            
            .date {
                font-size: 3rem;
            }
            
            form {
                flex-direction: column;
            }
            
            .coming-soon, .donate-section {
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Andrew Dezelan</h1>
            <p class="tagline">A Different Kind of Democrat</p>
            <p class="district">Indiana State Senate District 31</p>
        </div>
        
        <div class="coming-soon">
            <div class="date">2.6.26</div>
            <p class="message">Campaign launching soon. Stay tuned for updates.</p>
            
            <div class="email-signup">
                <form id="emailForm">
                    <input type="email" name="email" placeholder="Enter your email" required>
                    <button type="submit">Notify Me</button>
                </form>
                <p style="font-size: 0.9rem; color: #6b7280;">Be the first to know when we launch</p>
            </div>
        </div>
        
        <div class="donate-section">
            <h2>Support the Campaign</h2>
            <p style="margin-bottom: 25px;">Help us bring competent leadership to the State Senate</p>
            <a href="#" class="donate-button">Donate</a>
            <p class="disclaimer">
                Contributions are not tax deductible. Paid for by Friends of Andrew Dezelan.<br>
                Maximum contribution: $2,000 per individual per election cycle under Indiana law.
            </p>
        </div>
        
        <div class="footer">
            <div class="social-links">
                <a href="https://twitter.com/DezelanForSenate" target="_blank">Twitter</a>
                <a href="https://facebook.com/DezelanForSenate" target="_blank">Facebook</a>
                <a href="mailto:contact@dezelanforsenate.com">Email</a>
            </div>
            <p class="paid-for">Paid for by Friends of Andrew Dezelan</p>
        </div>
    </div>
    
    <script>
        document.getElementById('emailForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = this.querySelector('input[type="email"]').value;
            alert('Thanks! We\'ll notify you at ' + email + ' when we launch on 2.6.26');
            this.reset();
        });
    </script>
</body>
</html>
